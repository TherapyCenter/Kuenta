{
  "name": "kuenta",
  "version": "1.1.0",
  "description": "Kuenta – Werkstatt-Faktura als plattformunabhängige Webanwendung (übernimmt Datensicherungen aus KFZ-Faktura)",
  "main": "server/index.js",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server/index.js --open",
    "server": "node server/index.js",
    "netzwerk": "node -e \"process.env.HOST='0.0.0.0';require('./server/index.js')\"",
    "test": "node --test",
    "installer:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File installer/windows/build.ps1"
  }
}
